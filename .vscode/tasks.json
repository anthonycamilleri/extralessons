{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start dev environment",
            "type": "shell",
            "command": "docker compose up --build",
            "isBackground": true,
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated" },
            "detail": "Boot Postgres + Django (autoreload) + notifier at http://localhost:8000"
        },
        {
            "label": "Stop dev environment",
            "type": "shell",
            "command": "docker compose down",
            "problemMatcher": []
        },
        {
            "label": "Run tests",
            "type": "shell",
            "command": "docker compose run --rm web pytest",
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "Seed demo data",
            "type": "shell",
            "command": "docker compose run --rm web python manage.py seed_demo",
            "problemMatcher": [],
            "detail": "Creates demo admin/provider/parent accounts, a term and sample classes"
        },
        {
            "label": "Create superuser",
            "type": "shell",
            "command": "docker compose run --rm web python manage.py createsuperuser",
            "problemMatcher": []
        },
        {
            "label": "Make migrations",
            "type": "shell",
            "command": "docker compose run --rm web python manage.py makemigrations",
            "problemMatcher": []
        },
        {
            "label": "Django shell",
            "type": "shell",
            "command": "docker compose run --rm web python manage.py shell",
            "problemMatcher": []
        },
        {
            "label": "Tail logs",
            "type": "shell",
            "command": "docker compose logs -f web notifier",
            "isBackground": true,
            "problemMatcher": []
        }
    ]
}
