# Copy to deploy/scaleway.env and edit. Read by deploy/provision.sh.
#
# This file is configuration plus the few secrets you already hold (the
# ZeptoMail token; optionally a SECRET_KEY and MCP_API_TOKEN carried over from
# a previous host). Everything provision.sh generates or is handed by the API
# is written to deploy/.scaleway-state instead. Both files are gitignored.

# Names every resource: the database, registry namespace, container and both
# jobs are derived from it.
APP_NAME=extralessons

# The hostname parents use. Sets SITE_URL and is the domain attached for TLS.
# Leave empty to run on the endpoint Scaleway generates.
DOMAIN=www.esljparents.eu
# A bare domain to accept alongside (ALLOWED_HOSTS, CSRF_TRUSTED_ORIGINS).
# Needs an ALIAS/ANAME record at the registrar, since an apex cannot CNAME.
APEX_DOMAIN=esljparents.eu

# The first administrator: created by the migrate job's ensure_admin run with a
# set-password email. Further admins are added from the admin itself.
ADMIN_EMAIL=you@example.com

TIME_ZONE=Europe/Malta

# fr-par is the only region with all three of Serverless Containers,
# Serverless Jobs and Serverless SQL Database.
REGION=fr-par

# 0 = scale to zero after 15 idle minutes (a cold start of a few seconds on the
# first request after that); 1 = one instance always warm, billed continuously.
MIN_SCALE=0

# --- Email: Zoho ZeptoMail over its API ---
# The From address must be on a domain verified in the Mail Agent. Quote it:
# it contains spaces and angle brackets, and provision.sh sources this file.
DEFAULT_FROM_EMAIL="ESLJ Parents <info@esljparents.eu>"
# The Mail Agent's Send Mail token (SMTP/API tab). The copy button copies it
# as "Zoho-enczapikey <token>"; either form works.
ZEPTOMAIL_SEND_MAIL_TOKEN=""
# EU data centre accounts use api.zeptomail.eu; .com accounts
# https://api.zeptomail.com/v1.1/email.
ZEPTOMAIL_API_URL=https://api.zeptomail.eu/v1.1/email

# --- Carried over from a previous host (optional) ---
# Set these to the values the previous host used and every parent's session,
# password-reset link and the Claude connector survive the move. Left empty,
# provision.sh generates fresh ones.
# SECRET_KEY=
# MCP_API_TOKEN=

# --- Escape hatches for re-runs ---
# SKIP_BUILD=true      # the bootstrap image is already pushed
# SKIP_MIGRATE=true    # do not run the migration job (e.g. before restoring a dump)
