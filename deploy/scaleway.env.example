# Copy to deploy/scaleway.env and edit. Read by deploy/provision.sh.
#
# This file is configuration, not secrets — the only secret here is the SMTP
# password. Everything provision.sh generates or is handed by the API is
# written to deploy/.scaleway-state instead. Both are gitignored.

# Names every resource: the database, bucket, registry namespace, container
# and both jobs are derived from it.
APP_NAME=extralessons

# The hostname parents will use. Sets ALLOWED_HOSTS, CSRF_TRUSTED_ORIGINS and
# SITE_URL on the container, and is the domain attached for TLS.
DOMAIN=activities.example.com

# Used for the "create the first admin" command printed at the end.
ADMIN_EMAIL=you@example.com

TIME_ZONE=Europe/Malta

# fr-par is the only region with all three of Serverless Containers,
# Serverless Jobs and Serverless SQL Database.
REGION=fr-par

# Bucket names share one global namespace across all Scaleway customers.
# Defaults to $APP_NAME-media; change it if that name is taken.
# BUCKET=myschool-extralessons-media

# --- Email ---
# Ports 25 and 465 are blocked outbound on Scaleway Serverless. Use 587.
# For Scaleway Transactional Email, leave EMAIL_HOST as-is and set
# SMTP_PASSWORD to a TEM SMTP credential.
EMAIL_HOST=smtp.tem.scw.cloud
EMAIL_PORT=587
# Quote this one: it contains spaces and angle brackets, and provision.sh
# sources this file as shell.
DEFAULT_FROM_EMAIL="School Activities <notifications@activities.example.com>"
SMTP_PASSWORD=""

# --- Escape hatches for re-runs ---
# SKIP_BUILD=true      # the bootstrap image is already pushed
# SKIP_MIGRATE=true    # do not run the migration job
