# Copy to .env for local development. Docker Compose reads it, and so does
# Django directly (config/settings/base.py) when you run without Docker.
#
# In production none of this is a file: the same names are set as environment
# variables on the Render services, most of them from render.yaml. See
# docs/render-setup.md.

# --- Core ---
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
TIME_ZONE=Europe/Malta
LOG_LEVEL=INFO

# --- Database ---
# Leave unset for SQLite (zero setup — just `python manage.py runserver`).
# Set it to run against the Postgres container from docker-compose.yml, which
# you need for the row-locking tests in tests/test_capacity_race.py.
# DATABASE_URL=postgres://app:app@localhost:5432/extralessons
POSTGRES_PASSWORD=app

# --- Production only (set on Render, not here) ---
# Only needed once a custom domain is attached: without them the app serves
# the generated *.onrender.com hostname Render passes in automatically.
# ALLOWED_HOSTS=activities.example.com
# CSRF_TRUSTED_ORIGINS=https://activities.example.com
# SITE_URL=https://activities.example.com
#
# Render Postgres: render.yaml wires DATABASE_URL from the database itself.
# Connections are encrypted by default (sslmode=require); DB_SSLMODE=prefer
# is the escape hatch for a private network without TLS.
# DATABASE_URL=postgres://app:<password>@<host>/extralessons
#
# Client-side connection pool. Every instance holds up to DB_POOL_MAX_SIZE
# connections, so raise the instance count and this together.
# DB_POOL=true
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=4
#
# Uploaded class images are stored in the database in production (apps/media)
# and need no configuration. Set S3_BUCKET to use an S3-compatible bucket
# instead (Scaleway Object Storage, Cloudflare R2, AWS S3...).
# S3_BUCKET=extralessons-media
# S3_REGION=fr-par
# S3_ENDPOINT_URL=https://s3.fr-par.scw.cloud
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_CUSTOM_DOMAIN=          # CDN hostname in front of the bucket, if any
#
# Turn off only if you hit a redirect loop — see docs/render-setup.md.
# SECURE_SSL_REDIRECT=true

# --- Email ---
# Development prints email to the console whatever is set here.
DEFAULT_FROM_EMAIL=School Activities <notifications@example.com>

# Production: Zoho ZeptoMail over its API. Setting the token selects the
# backend; the From address above must be on a domain verified in ZeptoMail.
# EU-data-centre accounts (zeptomail.zoho.eu) use api.zeptomail.eu, others
# https://api.zeptomail.com/v1.1/email.
# ZEPTOMAIL_SEND_MAIL_TOKEN=
# ZEPTOMAIL_API_URL=https://api.zeptomail.eu/v1.1/email
# ZEPTOMAIL_BOUNCE_ADDRESS=

# Or plain SMTP (used in production only when no ZeptoMail token is set).
# Use 587 with STARTTLS; many hosts block 25 outright.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=notifications@example.com
# EMAIL_HOST_PASSWORD=change-me
# EMAIL_USE_TLS=true

# --- WhatsApp (Meta Cloud API) ---
# Leave WHATSAPP_ENABLED=false to log WhatsApp messages instead of sending.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0

# --- Notifier ---
NOTIFIER_BATCH_SIZE=20
NOTIFIER_MAX_ATTEMPTS=5
# Time budget for `run_notifier --drain`, the mode the scheduled Job uses.
NOTIFIER_DRAIN_MAX_SECONDS=300
# Deliver queued notifications in the request that queued them, rather than
# waiting for the nightly sweep. Turn off to go back to sweep-only delivery.
NOTIFIER_INLINE_DELIVERY=true
# How long an inline pass may spend sending before handing the rest back to the
# queue. This lands in a user's request, so it is a latency budget.
NOTIFIER_INLINE_MAX_SECONDS=20
