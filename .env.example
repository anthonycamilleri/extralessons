# Copy to .env for local development. Docker Compose reads it, and so does
# Django directly (config/settings/base.py) when you run without Docker.
#
# In production none of this is a file: the same names are set as environment
# variables on the Serverless Container and Jobs. See docs/scaleway-setup.md.

# --- Core ---
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
TIME_ZONE=Europe/Malta
LOG_LEVEL=INFO

# --- Database ---
# Leave unset for SQLite (zero setup — just `python manage.py runserver`).
# Set it to run against the Postgres container from docker-compose.yml, which
# you need for the row-locking tests in tests/test_capacity_race.py.
# DATABASE_URL=postgres://app:app@localhost:5432/extralessons
POSTGRES_PASSWORD=app

# --- Production only (set on Scaleway, not here) ---
# ALLOWED_HOSTS=activities.example.com
# CSRF_TRUSTED_ORIGINS=https://activities.example.com
# SITE_URL=https://activities.example.com
#
# Serverless SQL Database: the username is an IAM application ID and the
# password is that application's API secret key. sslmode=require is mandatory.
# DATABASE_URL=postgres://<application-id>:<api-secret-key>@<host>.pg.sdb.fr-par.scw.cloud:5432/extralessons?sslmode=require
#
# Client-side connection pool. Every container instance holds up to
# DB_POOL_MAX_SIZE connections, so raise max-scale and this together.
# DB_POOL=true
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=4
#
# Object Storage for uploaded class images. Without a bucket, uploads land on
# the container's ephemeral disk and vanish.
# S3_BUCKET=extralessons-media
# S3_REGION=fr-par
# S3_ENDPOINT_URL=https://s3.fr-par.scw.cloud
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_CUSTOM_DOMAIN=          # Edge Services hostname, to serve media via CDN
#
# Turn off only if you hit a redirect loop — see docs/scaleway-setup.md.
# SECURE_SSL_REDIRECT=true

# --- Email (SMTP) ---
# Ports 25 and 465 are blocked outbound on Scaleway Serverless. Use 587.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=notifications@example.com
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=School Activities <notifications@example.com>

# --- WhatsApp (Meta Cloud API) ---
# Leave WHATSAPP_ENABLED=false to log WhatsApp messages instead of sending.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0

# --- Notifier ---
NOTIFIER_BATCH_SIZE=20
NOTIFIER_MAX_ATTEMPTS=5
# Time budget for `run_notifier --drain`, the mode the scheduled Job uses.
NOTIFIER_DRAIN_MAX_SECONDS=300
